# ─────────────────────────────────────────────────────────────
# COMPLYMIND AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Spring Profile ────────────────────────────────────────────
# Options: dev (H2 file DB), postgres (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# ── Email / SMTP (for notifications) ─────────────────────────
# Example with Gmail App Password:
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password-here

# ── PostgreSQL (only required when SPRING_PROFILES_ACTIVE=postgres) ──
POSTGRES_USER=complymind
POSTGRES_PASSWORD=complymind_secret
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/complymind
SPRING_DATASOURCE_USERNAME=complymind
SPRING_DATASOURCE_PASSWORD=complymind_secret

# ── Application Security ──────────────────────────────────────
# Change this to a random 32+ character string in production
APP_SECURITY_JWT_SECRET=replace-me-with-a-secure-random-value-min32chars

# ── File Storage ──────────────────────────────────────────────
# Absolute path or relative path (./uploads/evidence by default)
APP_STORAGE_UPLOAD_DIR=./uploads/evidence

# ── Risk Engine Weights (optional overrides) ──────────────────
# These sum to 1.0 and must balance across all four factors
APP_RISK_WEIGHTS_DEADLINE_URGENCY=0.35
APP_RISK_WEIGHTS_BLOCKED_DEPENDENCY=0.30
APP_RISK_WEIGHTS_EVIDENCE_DEFICIENCY=0.20
APP_RISK_WEIGHTS_UNRESOLVED_PENDENCY=0.15
